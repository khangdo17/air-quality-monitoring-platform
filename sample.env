# Copy this file to .env for local development.
# Never commit real secrets.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional. Google Air Quality API key, restricted to the Air Quality API only.
# When absent the pipeline falls back to Open-Meteo CAMS for air quality.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# auto   call Google on even hours only (default, stays inside the free tier)
# always call Google on every run (manual backfill; 2x the calls)
# never  ignore the key and use Open-Meteo CAMS only
GOOGLE_AIR_QUALITY_MODE=auto

# Optional override. Ho Chi Minh City uses UTC+7.
CITY_TIMEZONE=Asia/Bangkok
