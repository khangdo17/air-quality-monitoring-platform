# Copy this file to .env for local development.
# Never commit real secrets.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Master switch for the Google Air Quality API. DEFAULTS TO FALSE.
# While this is not exactly true/1/yes/on the pipeline never calls Google, even
# with a key present, and records google_status = 'disabled'.
#
# It is off on purpose. Google Maps Platform Terms of Service 3.2.3(e) (No Use
# With Non-Google Maps) forbids using a Core Service "with or near a non-Google
# Map", and /air-quality renders a custom Three.js map. Read
# docs/attribution-and-terms.md before setting this to true: the dashboard also
# needs Google's attribution (logo included) and Terms of Use / Privacy Policy
# pages first.
GOOGLE_AQ_ENABLED=false

# Optional. Google Air Quality API key, restricted to the Air Quality API only.
# Ignored entirely while GOOGLE_AQ_ENABLED is false. When the switch is on and
# this is absent, the pipeline falls back to Open-Meteo CAMS for air quality.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Only consulted when GOOGLE_AQ_ENABLED=true.
# auto   call Google on even hours only (default, stays inside the free tier)
# always call Google on every run (manual backfill; 2x the calls)
# never  ignore the key and use Open-Meteo CAMS only
GOOGLE_AIR_QUALITY_MODE=auto

# Optional override. Ho Chi Minh City uses UTC+7.
CITY_TIMEZONE=Asia/Bangkok
